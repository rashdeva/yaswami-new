# Source: Telegram-каналы и группы через запятую: username без @, закрытые — числовой id из npm run chats.
# Только дополняет таблицу sources при старте; остальное — в админке («Источники»). Можно оставить пустым.
CHANNELS=

# Юзербот. Ключи: my.telegram.org → API development tools.
# TG_SESSION появится после pnpm --filter @yaswami/collector run login.
TG_API_ID=
TG_API_HASH=
TG_SESSION=


# Instagram через Apify (src/instagram.mjs): без токена профили Instagram не читаются и не ищутся.
# Токен: console.apify.com → Settings → API & Integrations. APIFY_MAX_USD — потолок трат одного запуска актора.
APIFY_TOKEN=
APIFY_MAX_USD=0.5
# Профили Instagram читаются раз в столько часов: Apify берёт деньги за каждую публикацию.
INSTAGRAM_POLL_HOURS=6

# Gemini API, бесплатный уровень: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Пауза между запросами к ИИ: бесплатный уровень ограничен по запросам в минуту.
LLM_PAUSE_MS=4500
EXTRACT_MODEL=gemini-3.5-flash-lite

# Postgres с таблицами collected_events и collector_cursors (миграции — в apps/api).
DATABASE_URL=postgres://yaswami:yaswami@localhost:5432/yaswami

# Публикации старше этого срока в ИИ не отправляются.
MAX_AGE_DAYS=14

# События источника, из которого за 90 дней одобрено столько событий и ни одно не отклонено, пишутся сразу одобренными. 0 — выключено.
AUTO_APPROVE_MIN=5

# Поиск источников для городов: новому — сразу, остальным — раз в столько дней (0 — только по просьбе команды).
SOURCE_SEARCH_DAYS=30
# Найденный канал с таким числом похожих на анонс публикаций за месяц сразу становится источником. 0 — не добавлять самим.
SOURCE_AUTO_ADD_MIN=3

# 0 — один проход и выход (для cron); иначе пауза между проходами.
POLL_MINUTES=15
SIGNUP_MESSAGE=Привет! Я нашёл событие «{title}» на Ясвами, хочу записаться.

# Аккаунты, с которых мы пишем людям (src/sender.mjs). Без этих трёх переменных выключено.
# ACCOUNTS_KEY — ключ шифрования сессий аккаунтов: openssl rand -hex 32. Потеряли ключ — аккаунты придётся добавить заново.
ACCOUNTS_KEY=
# Адрес API (с /api) и общий с ним секрет: сюда сборщик сообщает о личных сообщениях на аккаунтах.
API_URL=
COLLECTOR_SECRET=

# Большие чаты, где ищем вопросы «куда сходить» (src/lead.mjs): username без @ через запятую. Анонсы из них не берём.
# Работает вместе с API_URL и COLLECTOR_SECRET.
LEAD_CHATS=

# Чаты о работе (src/jobs.mjs): username без @ через запятую. Из них берём только вакансии — ни мастеров, ни вопросов.
# Вакансии ищем и в LEAD_CHATS. API_URL для этого не нужен.
JOB_CHATS=

# Разведка чатов (npm run scout): сессия запасного аккаунта — npm run login SCOUT_SESSION. За сколько дней читать историю.
SCOUT_SESSION=
SCOUT_DAYS=30

# Пауза перед первым подключением к Telegram после старта: за это время Railway останавливает прежний контейнер.
# На Railway по умолчанию 45000, локально 0.
STARTUP_DELAY_MS=

# Фото и видео анонсов (ADR-0006): S3-совместимый бакет с открытым чтением, Cloudflare R2.
# S3_ENDPOINT — https://<account_id>.r2.cloudflarestorage.com; MEDIA_PUBLIC_URL — открытый адрес бакета (r2.dev или свой домен).
# Без них медиа не сохраняются.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=
