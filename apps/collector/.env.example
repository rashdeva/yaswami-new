# Source: Telegram-каналы и группы через запятую: username без @, закрытые — числовой id из npm run chats
CHANNELS=

# Юзербот. Ключи: my.telegram.org → API development tools.
# TG_SESSION появится после pnpm --filter @yaswami/collector login.
TG_API_ID=
TG_API_HASH=
TG_SESSION=

CITY=Дананг
TIMEZONE=Asia/Ho_Chi_Minh

# Gemini API, бесплатный уровень: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Пауза между запросами к ИИ: бесплатный уровень ограничен по запросам в минуту.
LLM_PAUSE_MS=4500
EXTRACT_MODEL=gemini-3.5-flash-lite

# Postgres с таблицами collected_events и collector_cursors (миграции — в apps/api).
DATABASE_URL=postgres://yaswami:yaswami@localhost:5432/yaswami

# Публикации старше этого срока в ИИ не отправляются.
MAX_AGE_DAYS=14

# 0 — один проход и выход (для cron); иначе пауза между проходами.
POLL_MINUTES=15
SIGNUP_MESSAGE=Привет! Я нашёл событие «{title}» на Ясвами, хочу записаться.

# Аккаунты, с которых мы пишем людям (src/sender.mjs). Без этих трёх переменных выключено.
# ACCOUNTS_KEY — ключ шифрования сессий аккаунтов: openssl rand -hex 32. Потеряли ключ — аккаунты придётся добавить заново.
ACCOUNTS_KEY=
# Адрес API (с /api) и общий с ним секрет: сюда сборщик сообщает о личных сообщениях на аккаунтах.
API_URL=
COLLECTOR_SECRET=

# Большие чаты, где ищем вопросы «куда сходить» (src/lead.mjs): username без @ через запятую. Анонсы из них не берём.
# Работает вместе с API_URL и COLLECTOR_SECRET.
LEAD_CHATS=

# Пауза перед первым подключением к Telegram после старта: за это время Railway останавливает прежний контейнер.
# На Railway по умолчанию 45000, локально 0.
STARTUP_DELAY_MS=
