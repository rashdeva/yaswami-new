BOT_TOKEN=
DATABASE_URL=postgres://yaswami:yaswami@localhost:5432/yaswami
VITE_BOT_USERNAME=
VITE_APP_NAME=app
# Только для разработки в браузере без Telegram: pnpm api:token <telegram id> <имя>
VITE_DEV_TOKEN=
# Вход на сайте через Telegram: Client Secret из @BotFather (бот → Login Widget). В Allowed URLs там же добавить
# адрес сайта и <адрес>/api/auth/telegram/callback. Без секрета вход с сайта выключен, витрина работает.
TG_CLIENT_SECRET=
# Адрес сайта для ссылок и возврата после входа. На Railway берётся из RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=
CITY=Дананг
TIMEZONE=Asia/Ho_Chi_Minh
# Возможности, открытые всем (имена из Feature в packages/core), через запятую. Пусто — только тем, кому включили в админке.
# event_create — создавать события: без неё это могут организаторы, подтвердившие своё событие, и отмеченные командой.
FEATURES_ON=
# Сколько событий организатор создаёт бесплатно. Сверх лимита — отказ (подписки пока нет).
FREE_EVENTS_LIMIT=10
# Бот: вебхук и событие из сообщения. Секрет — любая строка из A-Z a-z 0-9 _ -, та же, что в setWebhook (secret_token).
# Без секрета вебхук закрыт.
TELEGRAM_WEBHOOK_SECRET=
# Уведомления о записи: пауза перед отправкой (гость может передумать, записи собираются в сводку организатору)
# и сколько сообщений в минуту один человек может прислать роли поддержки.
NOTIFY_DELAY_MS=20000
BOT_MESSAGES_PER_MINUTE=5
# Сколько запросов к API в минуту делает один вошедший человек или токен; сверх — ответ 429.
REQUESTS_PER_MINUTE=300
# Telegram id тех, кому открыта админка переписки (/admin), через запятую.
ADMIN_IDS=
# Роль поддержки в Hermes: адрес HTTP-входа профиля support и его ключ. Пусто — бот отвечает «ответим позже», диалог ждёт команду.
SUPPORT_URL=
SUPPORT_KEY=
# Общий со сборщиком секрет: им он подписывает сообщения с аккаунтов Telegram (тот же — в окружении сборщика).
COLLECTOR_SECRET=
# Ключ шифрования сборщика (тот же ACCOUNTS_KEY, что у него): им API шифрует код и пароль входа в наш аккаунт Telegram,
# пока их не заберёт сборщик. Пусто — они лежат в базе открытыми.
ACCOUNTS_KEY=
# Кому роль поддержки отвечает: Telegram id через запятую. Пусто — всем.
SUPPORT_USER_IDS=
# Отзывы после события: сколько по событию не должно быть новых отзывов, чтобы организатору ушла сводка.
FEEDBACK_SETTLE_MS=600000
# Роль illustrator в Hermes: рисует ролик о событии по запросу оператора. Пусто — выключено.
# ILLUSTRATOR_DAILY_LIMIT — сколько роликов можно заказать за сутки (каждый стоит 1–2 доллара).
ILLUSTRATOR_URL=
ILLUSTRATOR_KEY=
ILLUSTRATOR_DAILY_LIMIT=3
# Роль hunter в Hermes: отвечает на вопросы «куда сходить» в чатах черновиками. Пусто — выключено.
# HUNTER_USER_IDS — на время проверки: реагировать только на вопросы этих людей (Telegram id через запятую).
HUNTER_URL=
HUNTER_KEY=
HUNTER_USER_IDS=
# Роль host в Hermes: пишет организаторам, к которым через нас записались, — черновиками. Пусто — выключено.
HOST_URL=
HOST_KEY=
