{
  "name": "yaswami",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"packages/**/*.test.ts\" \"apps/**/*.test.ts\"",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @yaswami/api exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @yaswami/api exec drizzle-kit migrate"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9"
  }
}
